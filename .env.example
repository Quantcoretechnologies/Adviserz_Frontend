# -----------------------------------------------------------------------------
# Adviserz web — environment variables
# Copy to `.env.local` for local development. NEVER commit a real env file.
# Every variable is validated at startup (src/config/env.ts).
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time:
# set them before `npm run build`, and never put secrets in them.
# -----------------------------------------------------------------------------

# Backend base URL including the API prefix (adviserz_be PORT + API_PREFIX)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public origin of this web app. Must be listed in the backend's CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
